# These are paths, not credentials. The CLI reads environment variables; it does not load .env files.
# export ZUNARA_CONFIG_DIR="$HOME/.config/zunara"
# export ZUNARA_DATA_DIR="$HOME/.local/share/zunara"
# export ZUNARA_YOUTUBE_CLIENT_SECRET="$HOME/.config/zunara/client_secret.json"
# Optional multi-platform publisher: set UPLOAD_POST_API_KEY in your process environment,
